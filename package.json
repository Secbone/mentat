{
  "name": "mentat",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.26.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "gen": "node scripts/gen-aliases.mjs",
    "check:layering": "node scripts/check-layering.mjs",
    "dev": "tsx packages/cli/src/bin.ts",
    "test": "node scripts/gen-aliases.mjs && vitest run",
    "test:watch": "vitest",
    "typecheck": "node scripts/gen-aliases.mjs && tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test:architecture": "node --test scripts/check-layering.test.mjs",
    "check": "node scripts/gen-aliases.mjs && node scripts/check-layering.mjs && node --test scripts/check-layering.test.mjs && tsc --noEmit && vitest run && biome check ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.8",
    "@types/node": "^24.10.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
